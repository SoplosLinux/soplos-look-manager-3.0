{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "soplos-look-manager",
  "version": "3.0.0-beta",
  "identifier": "org.soplos.lookmanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:helper && npm run build",
    "devUrl": "http://localhost:1433",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Soplos Look Manager",
        "width": 1000,
        "height": 700,
        "minWidth": 860,
        "minHeight": 560,
        "resizable": true,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "/usr/share/**",
          "$HOME/**",
          "$HOME/.local/share/**",
          "$HOME/.themes/**",
          "$HOME/.icons/**",
          "$HOME/.cache/soplos-look-manager/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb"
    ],
    "publisher": "Sergi Perich",
    "homepage": "https://soplos.org",
    "copyright": "Copyright © 2026 Sergi Perich",
    "license": "GPL-3.0-or-later",
    "licenseFile": "../LICENSE",
    "category": "Utility",
    "shortDescription": "Themes and layout manager for Soplos Linux Plasma",
    "longDescription": "Soplos Look Manager changes how Soplos Linux Tyson looks: global themes, wallpapers, icons, cursors, the panel layout, the start-up screen and the Plasma Login Manager.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "section": "utils",
        "priority": "optional",
        "depends": [
          "pkexec | policykit-1",
          "libqt6widgets6",
          "libqt6quick6",
          "libkf6svg6",
          "libkf6colorscheme6",
          "libkf6package6",
          "libkf6configcore6",
          "libkf6coreaddons6",
          "libkdecorations3-6",
          "libkdecorations3private2",
          "kpackagetool6",
          "knewstuff-dialog6",
          "kdialog | zenity",
          "unzip"
        ],
        "recommends": [
          "plasma-desktop"
        ],
        "changelog": "../CHANGELOG.md",
        "desktopTemplate": "resources/debian/soplos-look-manager.desktop.hbs",
        "files": {
          "/usr/lib/soplos-look-manager/soplos-look-manager-style-preview": "resources/lib/soplos-look-manager-style-preview",
          "/usr/share/polkit-1/actions/org.soplos.lookmanager.policy": "resources/polkit/org.soplos.lookmanager.policy",
          "/usr/share/metainfo/org.soplos.lookmanager.metainfo.xml": "resources/appstream/org.soplos.lookmanager.metainfo.xml",
          "/usr/share/doc/soplos-look-manager/copyright": "resources/debian/copyright"
        }
      }
    }
  }
}
